{
  "name": "dsh-weixin",
  "version": "0.3.1",
  "description": "微信 ClawBot (iLink) 多账号通道插件：把多个微信机器人接入 DeepSeek Harness，按账号和用户隔离会话、工作目录与消息回发。",
  "type": "module",
  "main": "index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "src",
    "bin",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "bin": {
    "dsh-weixin-login": "bin/login.mjs"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.1",
    "qrcode-generator": "^2.0.4"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caoyilearnai/dsh-weixin.git"
  },
  "homepage": "https://github.com/caoyilearnai/dsh-weixin#readme",
  "bugs": {
    "url": "https://github.com/caoyilearnai/dsh-weixin/issues"
  },
  "engines": {
    "node": ">=20.3.0"
  },
  "scripts": {
    "test": "node --test",
    "prepublishOnly": "npm test"
  },
  "keywords": [
    "deepseek-harness",
    "weixin",
    "wechat",
    "ilink",
    "clawbot",
    "plugin",
    "bundle"
  ]
}
